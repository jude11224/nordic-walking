{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "healthy-futures",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-26",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Stores the calendar events. Cloudflare creates this namespace
  // automatically the first time the site is deployed.
  "kv_namespaces": [
    { "binding": "EVENTS" }
  ]
}
