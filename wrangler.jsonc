{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "healthy-futures",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-26",
  // Never delete variables that were set in the Cloudflare dashboard.
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Storage. Cloudflare creates these namespaces automatically the first
  // time the site is deployed.
  "kv_namespaces": [
    // The calendar events.
    { "binding": "EVENTS" },
    // A backup copy of every registration form, in case an email goes missing.
    { "binding": "REGISTRATIONS" }
  ],
  // Emails registration forms to Julie. Locked to her address, so it can't
  // be used to email anyone else. See README for the one-time setup.
  "send_email": [
    { "name": "REGISTRATION_EMAIL", "destination_address": "julie7747@gmail.com" }
  ]
}
