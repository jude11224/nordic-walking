{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "healthy-futures",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-26",
  // Never delete variables that were set in the Cloudflare dashboard.
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Storage. Cloudflare creates these namespaces automatically the first
  // time the site is deployed.
  "kv_namespaces": [
    // The calendar events.
    { "binding": "EVENTS" },
    // Every registration form. Email is off for now; see README to turn it on.
    { "binding": "REGISTRATIONS" }
  ]
}
